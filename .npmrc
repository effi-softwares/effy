# Required by AWS Amplify Hosting for pnpm + Turborepo monorepos (042-customer-web-cicd, research D4).
#
# Amplify's monorepo build reads pnpm/Turborepo configuration from a root .npmrc and expects the
# node linker set to `hoisted` (a flat, npm-style node_modules) rather than pnpm's default symlinked
# layout. Without this, the Amplify build cannot resolve the workspace the way it expects.
#
# ⚠ This changes install linking for the ENTIRE monorepo, not just customer-web. If a package breaks
# under hoisted linking, fix the package — do not weaken its isolation silently. Re-verify with a
# clean `pnpm install` + `pnpm -r typecheck` + `pnpm -r test` after any change here.
node-linker=hoisted
