{
  "name": "@effy/edge-notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effy cold-path notifications worker \u2014 drains the notification_request outbox and sends push via FCM (050), and drains the receipt_dispatch outbox and sends the order receipt via SES (052).",
