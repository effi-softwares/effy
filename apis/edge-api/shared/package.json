{
  "name": "@effy/edge-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effy backend shared library — db/secrets/logger/http/claims/validate + the RFC 9457 error contract. Single source of truth for every edge service (Principle II). Exports TS source.",
  "exports": {
    ".": "./src/index.ts",
    "./delivery": "./src/delivery/index.ts",
    "./cart-policy": "./src/cart-policy/index.ts",
    "./payments": "./src/payments/index.ts",
    "./testing": "./src/testing/kotlin-fixture.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1088.0",
    "@aws-sdk/s3-request-presigner": "3.1088.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0"
  }
}
