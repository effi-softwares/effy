# Back-office web config (VITE_*, build-time, NON-SECRET) — contracts/config.contract.md.
# Copy to .env.local and fill from the 001/004 contract. NEVER commit real values.
VITE_COGNITO_USER_POOL_ID=   # ssm /effy/dev/auth/back-office/user_pool_id
VITE_COGNITO_CLIENT_ID=      # ssm /effy/dev/auth/back-office/app_client_id
VITE_API_BASE_URL=           # the STAFF gateway (075) — SSM /effy/dev/staff/api_endpoint; paths carry /admin/v1/...
#                              ⚠ NOT /effy/dev/edge/api_endpoint: that is the shared gateway, and since 075 it
#                              has no back-office authorizer — every call would 401.
# Optional telemetry — degrades to a no-op when absent.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ── Deployed (Amplify, 048-console-web-cicd) ──────────────────────────────────────────────────
# In the hosted dev build these VITE_* are supplied by Terraform (infra/envs/dev/amplify-consoles.tf)
# from in-account refs — no .env file, no operator step. All are PUBLIC-SAFE; the console carries NO
# secret. Reference values for dev:
#   VITE_COGNITO_USER_POOL_ID = module.back_office_pool.user_pool_id
#   VITE_COGNITO_CLIENT_ID    = module.back_office_pool.app_client_id
#   VITE_API_BASE_URL         = https://staff-api.dev.effyshopping.com  (the staff gateway, 075)
# The console is served at https://back-office.dev.effyshopping.com (CORS-allowed on the staff gateway).
