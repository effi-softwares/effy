<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 050 - runtime notification permission (API 33+); older versions grant it implicitly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EffyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Effy.Splash">
        <!-- 013 FR-020/D11: allowBackup=false keeps Amplify's encrypted token store off device backups.
             A finer-grained dataExtractionRules exclusion is spike S6/T058 (the exact prefs filenames). -->
        <!-- 116: singleTop - a link (or anything else) arriving while the app is open goes to THIS screen (onNewIntent).
             With the default, Android stacked a second MainActivity on top, and the first one - still composed underneath,
             sharing the container - took the link: the visible screen stayed on Home. -->
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 116 B7: Effy's shopper links open the app (Android App Links, verified against the website's
                 /.well-known/assetlinks.json). Exactly APP_LINK_PATHS (shared-types) - never unsubscribe, help, legal or
                 sign-in. The host is WEB_SITE_HOST (build config). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${effyLinkHost}" />
                <data android:path="/" />
                <data android:path="/orders" />
                <data android:pathPrefix="/orders/" />
                <data android:path="/account/points" />
                <data android:pathPrefix="/product/" />
                <data android:path="/search" />
                <data android:path="/offers" />
            </intent-filter>
        </activity>

        <!-- 050 - FCM service (class lives in :shared/androidMain, on the classpath). Forwards token
             rotation to the app; system tray displays backgrounded notifications. -->
        <!-- Push: what the system tray uses for a notification that arrives while the app is closed - the
             monochrome bell (the launcher icon draws as a white square in the status bar) and the Order updates
             channel - one of the app's channels per kind of message (111), all created at start (FCM falls back to "Miscellaneous" otherwise). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_effy_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="orders" />
        <service
            android:name="com.effyshopping.customer.mobile.core.push.EffyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 096 - shares an order document (the delivery note PDF) from cache/documents only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.documents"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/document_paths" />
        </provider>
    </application>

</manifest>
