<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 050 — runtime notification permission (API 33+); older versions grant it implicitly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EffyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Effy.Splash">
        <!-- 013 FR-020/D11: allowBackup=false keeps Amplify's encrypted token store off device backups.
             A finer-grained dataExtractionRules exclusion is spike S6/T058 (the exact prefs filenames). -->
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 050 — FCM service (class lives in :shared/androidMain, on the classpath). Forwards token
             rotation to the app; system tray displays backgrounded notifications. -->
        <service
            android:name="com.effyshopping.customer.mobile.core.push.EffyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
