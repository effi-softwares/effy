PRODUCT_NAME=customer-mobile
PRODUCT_BUNDLE_IDENTIFIER=com.effyshopping.customer.mobile.customer-mobile$(TEAM_ID)

// 121: the version and build number come from version.properties (scripts/bump-version.sh writes Version.xcconfig).
#include "Version.xcconfig"

