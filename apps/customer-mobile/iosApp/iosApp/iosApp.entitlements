<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). NOT ATTACHED YET: a free Apple account cannot sign an app that
	     carries this, so `CODE_SIGN_ENTITLEMENTS` in Configuration/Config.xcconfig is commented out
	     until the Apple Developer Program membership exists. Turning it on is that one line - see
	     docs/observability-apple-blockers.md. "development" is right for Xcode runs; an App Store /
	     TestFlight export rewrites it to "production" by itself. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
