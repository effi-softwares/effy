<?xml version="1.0" encoding="utf-8"?>
<!--
  General Sans as an ANDROID FONT RESOURCE (051 T008).

  ⚠ Why this exists when the same faces already live in `shared/src/commonMain/composeResources/font/`:
  Compose Resources are resolved by Compose's own loader and have NO `R.font` id. Stripe's mobile
  payment element takes a typeface as `PaymentSheet.Typography.fontResId` — an Android resource id —
  so without this file the element silently renders in the SYSTEM font next to Effy's own type.
  Nothing fails to compile and nothing errors at runtime; it just looks wrong (research R8).

  Weights are 400/500/600 only, matching the design system. There is no Bold 700 face — `700` would
  synthesise a faux-bold rather than load a real one.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/general_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/general_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/general_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
</font-family>
