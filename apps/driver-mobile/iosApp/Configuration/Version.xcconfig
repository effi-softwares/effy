// The iOS app's own version (121) - independent of Android's version.properties. Raised ONLY by
// `make dm-ios-version [BUMP=patch|minor|major]` (scripts/bump-ios-version.sh) before an Xcode archive; commit it after.
// The build number goes up on every release build and never repeats (App Store Connect refuses a number it has seen).
MARKETING_VERSION = 1.0.2
CURRENT_PROJECT_VERSION = 4
