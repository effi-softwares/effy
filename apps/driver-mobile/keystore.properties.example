# Release signing for the driver Android app. Copy to keystore.properties (git-ignored) and fill in.
# The keystore itself (*.jks) is never committed - keep it and its passwords somewhere safe: every
# update to an installed app must be signed with the SAME key, or it will not install over it.
storeFile=release/effy-driver-release.jks
storePassword=
keyAlias=effy-driver
keyPassword=
