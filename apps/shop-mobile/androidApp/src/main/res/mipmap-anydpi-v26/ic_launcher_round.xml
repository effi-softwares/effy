<?xml version="1.0" encoding="utf-8"?>
<!-- 024 — adaptive icon (API 26+). The <monochrome> layer is what makes the app participate in
     Android 13+ themed icons (FR-007a); without it the launcher excludes the app entirely.
     Layers are generated by @effy/brand — do not hand-edit them. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
