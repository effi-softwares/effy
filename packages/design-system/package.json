{
  "name": "@effy/design-system",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "Effy web design system \u2014 the brand SSOT (MONOCHROME: a ten-step neutral ramp with NO brand hue, whose accent INVERTS by appearance \u2014 near-black on light, near-white on dark \u2014 plus exactly two bounded semantic colours; General Sans type; spacing/radius scales) + Tailwind v4 theme tokens + dark mode + cn util + the platform's one set of shadcn/ui primitives (constitution Principle V, v1.11.0). Internal package: exports TS source + CSS.",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-tokens.mjs",
    "tokens:test": "node scripts/check-tokens.mjs",
    "tokens:gen": "node scripts/gen-compose-theme.mjs",
    "tokens:check": "node scripts/check-compose-theme.mjs && node scripts/check-mobile-assets.mjs",
    "mobile-assets:sync": "node scripts/sync-mobile-assets.mjs",
    "mobile-assets:check": "node scripts/check-mobile-assets.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.2"
  }
}
