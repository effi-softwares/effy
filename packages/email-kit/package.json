{
  "name": "@effy/email-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every email the platform sends: a typed catalogue, MJML templates compiled at build time from the design-system tokens, and a renderer and SES sender.",
  "exports": {
    ".": "./src/index.ts",
    "./send": "./src/send.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-email.mjs",
    "email:gen": "node scripts/gen-email.mjs",
    "email:check": "node scripts/check-email.mjs",
    "email:preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "handlebars": "4.7.8"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": "^3"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "3.1086.0",
    "@effy/design-system": "workspace:*",
    "@types/node": "^22.10.0",
    "mjml": "4.15.3",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0"
  }
}
