<mj-table role="presentation" cellpadding="0" cellspacing="0" width="100%" css-class="e-ink">
  {{#each items}}
  <tr>
    <td class="e-ink" style="padding:10px 0 2px 0;color:%ink%;font-size:16px;line-height:22px;mso-line-height-rule:exactly;">{{name}}</td>
    <td class="e-ink" align="right" valign="top" style="padding:10px 0 2px 16px;color:%ink%;font-size:16px;line-height:22px;mso-line-height-rule:exactly;white-space:nowrap;font-weight:600;">{{lineTotal}}</td>
  </tr>
  <tr>
    <td class="e-muted" colspan="2" style="padding:0 0 10px 0;color:%mutedInk%;font-size:14px;line-height:20px;mso-line-height-rule:exactly;">{{unitPrice}} each &middot; Qty {{quantity}}</td>
  </tr>
  {{/each}}
</mj-table>
