<mj-table role="presentation" cellpadding="0" cellspacing="0" width="100%" css-class="e-ink">
  <tr>
    <td class="e-muted" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">Items subtotal</td>
    <td class="e-muted" align="right" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">{{subtotal}}</td>
  </tr>
  {{#if hasDiscount}}
  <tr>
    <td class="e-muted" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">{{discountLabel}}</td>
    <td class="e-muted" align="right" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">&minus;{{discountAmount}}</td>
  </tr>
  {{/if}}
  {{#if hasDeliveryLines}}
  {{#each deliveryLines}}
  <tr>
    <td class="e-muted" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">{{label}}</td>
    <td class="e-muted" align="right" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">{{amount}}</td>
  </tr>
  {{/each}}
  {{else}}
  {{#if hasDeliveryFee}}
  <tr>
    <td class="e-muted" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">Delivery</td>
    <td class="e-muted" align="right" style="padding:6px 0;color:%mutedInk%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;">{{deliveryFee}}</td>
  </tr>
  {{/if}}
  {{/if}}
  <tr>
    <td colspan="2" height="8" style="height:8px;line-height:8px;font-size:1px;">&nbsp;</td>
  </tr>
  <tr>
    <td class="e-bg-rule" colspan="2" height="1" style="height:1px;line-height:1px;font-size:1px;background-color:%hairline%;">&nbsp;</td>
  </tr>
  <tr>
    <td class="e-ink" style="padding:8px 0 0 0;color:%ink%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;font-weight:600;">Total paid</td>
    <td class="e-ink" align="right" style="padding:8px 0 0 0;color:%ink%;font-size:16px;line-height:24px;mso-line-height-rule:exactly;font-weight:600;">{{total}}</td>
  </tr>
  {{#if hasPoints}}
  <tr>
    <td class="e-muted" colspan="2" style="padding:10px 0 0 0;color:%mutedInk%;font-size:14px;line-height:20px;mso-line-height-rule:exactly;">Paid with {{pointsPaid}}</td>
  </tr>
  {{/if}}
  {{#if hasPaymentMethod}}
  <tr>
    <td class="e-muted" colspan="2" style="padding:10px 0 0 0;color:%mutedInk%;font-size:14px;line-height:20px;mso-line-height-rule:exactly;">Paid with {{paymentMethod}}</td>
  </tr>
  {{/if}}
</mj-table>
