<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Your {{effyProductName}} password</mj-title>
    <mj-preview>If this wasn&rsquo;t you, contact support straight away.</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">
          {{#if isFirstPassword}}A password was added to your account{{else}}Your password was changed{{/if}}
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          {{#if isFirstPassword}}A password was just added to your {{effyProductName}} account. You can now sign in with either your password or an emailed code.{{else}}Your {{effyProductName}} password was just changed.{{/if}}
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          For your security, this signed you out on every device.
        </mj-text>

        <mj-text mj-class="small" css-class="e-muted" padding="24px 0 0 0">
          If this wasn&rsquo;t you, contact {{effyProductName}} support straight away at {{effySupportEmail}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
