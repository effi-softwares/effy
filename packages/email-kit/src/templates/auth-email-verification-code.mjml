<!-- auth-email-verification-code — the code a person enters to verify a new or changed email address.
     ⚠ SENT BY COGNITO. Code is `{####}`; no `code` variable. See auth-sign-up-code.mjml for the rules.

     Audience-neutral copy (uses {{effyProductName}}), because an email attribute can be verified on
     any pool. -->

<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Verify your email for {{effyProductName}}</mj-title>
    <mj-preview>Enter this code to confirm this email address.</mj-preview>
  </mj-head>

  <mj-body width="600px" background-color="#f5f5f5" css-class="e-bg-page">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">Verify your email address</mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 24px 0">
          Enter this code to confirm this email address for {{effyProductName}}. It can only be used once.
        </mj-text>

        <mj-text mj-class="code" css-class="e-ink e-bg-code" align="center"
                 container-background-color="#f5f5f5" padding="24px 16px">{####}</mj-text>

        <mj-text mj-class="small" css-class="e-muted" padding="24px 0 0 0">
          If you didn&rsquo;t make this change, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
