<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Reset your {{effyProductName}} password</mj-title>
    <mj-preview>Enter this code to choose a new password.</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">Reset your password</mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 24px 0">
          Enter this code to choose a new {{effyProductName}} password. It can only be used once.
        </mj-text>

        <mj-text mj-class="code" css-class="e-ink e-bg-code" align="center"
                 padding="24px 16px">{####}</mj-text>

        <mj-text mj-class="small" css-class="e-muted" padding="24px 0 0 0">
          If you didn&rsquo;t ask to reset your password, you can ignore this email &mdash; your password
          stays the same until a new one is set with this code.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
