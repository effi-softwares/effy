<!-- auth-password-reset-code — the code a customer enters to reset a forgotten password.
     ⚠ SENT BY COGNITO. The code is `{####}` (Cognito substitutes it after the trigger returns); no
     `code` variable. See auth-sign-up-code.mjml for the full rules on Cognito-sent messages.

     ⚠ CUSTOMER-ONLY. Only the customer audience has passwords; the internal audiences are passwordless
     (035), so a password reset is not a concept for them. If this ever fires on an internal pool the
     interceptor's fail-safe returns the event unmodified and Cognito sends its default. -->

<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Reset your {{effyProductName}} password</mj-title>
    <mj-preview>Enter this code to choose a new password.</mj-preview>
  </mj-head>

  <mj-body width="600px" background-color="#f5f5f5" css-class="e-bg-page">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">Reset your password</mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 24px 0">
          Enter this code to choose a new {{effyProductName}} password. It can only be used once.
        </mj-text>

        <mj-text mj-class="code" css-class="e-ink e-bg-code" align="center"
                 container-background-color="#f5f5f5" padding="24px 16px">{####}</mj-text>

        <mj-text mj-class="small" css-class="e-muted" padding="24px 0 0 0">
          If you didn&rsquo;t ask to reset your password, you can ignore this email &mdash; your password
          stays the same until a new one is set with this code.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
