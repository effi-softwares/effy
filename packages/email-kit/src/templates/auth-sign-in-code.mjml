<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>{{code}} is your {{effyProductName}} sign-in code</mj-title>
    <mj-preview>Enter this code to sign in. It expires in {{expiryMinutes}} minutes.</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">Your sign-in code</mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 24px 0">
          {{#if isInternal}}Enter this code to sign in to your work account.{{else}}Enter this code to sign in.{{/if}}
          It expires in {{expiryMinutes}} minutes and can only be used once.
        </mj-text>

        <mj-text mj-class="code" align="center"
                 css-class="e-ink e-bg-code" padding="24px 16px">{{code}}</mj-text>

        <mj-text mj-class="small" css-class="e-muted" padding="24px 0 0 0">
          If you didn&rsquo;t ask to sign in, you can ignore this email &mdash; nobody can use the code without it.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
