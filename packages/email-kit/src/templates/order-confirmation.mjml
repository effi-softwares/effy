<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Your {{effyProductName}} order {{orderNumber}} is confirmed</mj-title>
    <mj-preview>{{deliveryPreheader}}</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 8px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">Your order is confirmed</mj-text>
        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          Thanks &mdash; we&rsquo;ve received your payment and your order is being prepared.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 32px 0 32px">
      <mj-column>
        <mj-text mj-class="small" css-class="e-muted">{{deliveryLabel}}</mj-text>
        <mj-text mj-class="body" css-class="e-ink" padding="4px 0 0 0" font-weight="600">{{deliveryEstimate}}{{#if deliveryMethod}} &middot; {{deliveryMethod}}{{/if}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="12px 32px 0 32px">
      <mj-column>
        <mj-text mj-class="small" css-class="e-muted">Order</mj-text>
        <mj-text mj-class="body" css-class="e-ink" padding="4px 0 0 0" font-weight="600">{{orderNumber}}</mj-text>
        <mj-text mj-class="small" css-class="e-muted" padding="2px 0 0 0">{{placedAt}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/divider.mjml" />

    <mj-section padding="8px 32px 0 32px">
      <mj-column>
        <mj-text mj-class="small" css-class="e-muted" padding="0 0 4px 0">What you ordered</mj-text>
        <mj-include path="../components/line-items.mjml" />
      </mj-column>
    </mj-section>

    <mj-include path="../components/divider.mjml" />

    <mj-section padding="16px 32px 0 32px">
      <mj-column>
        <mj-include path="../components/rows.mjml" />
      </mj-column>
    </mj-section>

    <mj-section padding="24px 32px 8px 32px">
      <mj-column>
        <mj-button href="{{orderUrl}}" css-class="e-btn-bg e-btn-fg" align="left">View your order</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 32px 0 32px">
      <mj-column>
        <mj-text mj-class="small" css-class="e-muted">Delivering to</mj-text>
        <mj-text mj-class="body" css-class="e-ink" padding="4px 0 0 0">{{deliveryAddress}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="12px 32px 16px 32px">
      <mj-column>
        <mj-text mj-class="small" css-class="e-muted">Billing address</mj-text>
        {{#if billingSameAsDelivery}}
        <mj-text mj-class="body" css-class="e-muted" padding="4px 0 0 0">Same as delivery</mj-text>
        {{else}}
        <mj-text mj-class="body" css-class="e-ink" padding="4px 0 0 0">{{billingAddress}}</mj-text>
        {{/if}}
      </mj-column>
    </mj-section>

    <mj-section padding="0 32px 8px 32px">
      <mj-column>
        <mj-text mj-class="small" css-class="e-muted">
          This is a record of payment. Prices include GST where it applies. If you need a tax invoice
          for this order, reply to this email or write to {{effySupportEmail}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
