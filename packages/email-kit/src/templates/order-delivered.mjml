<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Your {{effyProductName}} order {{orderNumber}} has arrived</mj-title>
    <mj-preview>Everything in your order has been delivered.</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">
          Your order has arrived
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          Order {{orderNumber}} was delivered on {{deliveredOn}}. Thanks for shopping with
          {{effyProductName}}.
        </mj-text>

        <mj-button href="{{orderUrl}}" css-class="e-btn-bg e-btn-fg" align="left" padding="24px 0 0 0">
          View your order
        </mj-button>

        <mj-text mj-class="small" css-class="e-muted" padding="16px 0 0 0">
          Your <a href="{{orderUrl}}#documents">delivery note</a> shows everything you were sent.
        </mj-text>

        <mj-text mj-class="small" css-class="e-muted" padding="20px 0 0 0">
          Something not right? Reply to this email or write to {{effySupportEmail}} and we&rsquo;ll
          sort it out.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
