<!-- order-with-courier — a parcel from the order has been handed to a courier (080 US4).

     ⚠ ONE EMAIL PER CONSIGNMENT. An order filled from more than one place travels as more than one
     parcel, and each is handed to the courier on its own; the customer's order page then says
     "Tracking for each parcel is sent to you by email" (080 Q8) — this is that email.

     ⚠ IT NAMES NO SHOP AND NO COUNT. "A parcel from your order", never "1 of 2": the catalogue gives
     this template no var to say how many there are, or who packed it.

     ⚠ NO DATE PROMISE. The courier's timeframe was sold as an estimate; this message does not turn
     it into a date. -->

<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>Your {{effyProductName}} order {{orderNumber}} is with the courier</mj-title>
    <mj-preview>A parcel from your order is on its way with {{courierName}}.</mj-preview>
  </mj-head>

  <mj-body width="600px" background-color="#f5f5f5" css-class="e-bg-page">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">
          Your order is with the courier
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          A parcel from order {{orderNumber}} has been handed to {{courierName}} and is on its way to you.
        </mj-text>

        {{#if hasReference}}
        <mj-text mj-class="body" css-class="e-ink" padding="16px 0 0 0">
          Courier reference: {{reference}}
        </mj-text>
        {{/if}}

        <!-- Both dark classes named so the label inverts with the fill (038's dark-mode button). -->
        {{#if hasTracking}}
        <mj-button href="{{trackingUrl}}" css-class="e-btn-bg e-btn-fg" align="left" padding="24px 0 0 0">
          Track your parcel
        </mj-button>
        <mj-text mj-class="small" css-class="e-muted" padding="12px 0 0 0">
          <a href="{{orderUrl}}">View your order</a>
        </mj-text>
        {{else}}
        <mj-button href="{{orderUrl}}" css-class="e-btn-bg e-btn-fg" align="left" padding="24px 0 0 0">
          View your order
        </mj-button>
        {{/if}}

        <mj-text mj-class="small" css-class="e-muted" padding="20px 0 0 0">
          Something not right? Reply to this email or write to {{effySupportEmail}} and we&rsquo;ll
          sort it out.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
