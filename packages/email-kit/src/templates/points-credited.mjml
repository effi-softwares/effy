<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>You've received {{points}} {{effyProductName}} points</mj-title>
    <mj-preview>They're worth ${{valueAmount}} off your next order.</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">
          You&rsquo;ve received {{points}} points
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          {{reasonWords}}. Your points are worth ${{valueAmount}} and you can use them on anything at
          checkout, delivery included.
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="16px 0 0 0">
          Use them by {{expiresOn}}.
        </mj-text>

        <mj-button href="{{pointsUrl}}" css-class="e-btn-bg e-btn-fg" align="left" padding="24px 0 0 0">
          See your points
        </mj-button>

        <mj-text mj-class="small" css-class="e-muted" padding="20px 0 0 0">
          Points have no cash value and can&rsquo;t be exchanged for money. Questions? Reply to this
          email or write to {{effySupportEmail}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
