<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="../generated/theme.mjml" />
    <mj-title>{{points}} of your {{effyProductName}} points expire on {{expiresOn}}</mj-title>
    <mj-preview>Use them before then - they're worth ${{valueAmount}}.</mj-preview>
  </mj-head>

  <mj-body width="600px">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="0 32px 32px 32px">
      <mj-column>
        <mj-text mj-class="h1" css-class="e-ink e-h1">
          Your points expire soon
        </mj-text>

        <mj-text mj-class="muted" css-class="e-muted" padding="12px 0 0 0">
          {{points}} of your points, worth ${{valueAmount}}, can be used until {{expiresOn}}. After that
          they can&rsquo;t be used.
        </mj-text>

        <mj-button href="{{shopUrl}}" css-class="e-btn-bg e-btn-fg" align="left" padding="24px 0 0 0">
          Start shopping
        </mj-button>

        <mj-text mj-class="small" css-class="e-muted" padding="20px 0 0 0">
          See your balance any time at {{pointsUrl}}. Questions? Reply to this email or write to
          {{effySupportEmail}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
