    "DriverMeDTO": {
      "additionalProperties": false,
      "description": "GET /driver/v1/me — the record-backed identity read. Display strings only; no currency.",
      "properties": {
        "dutyStatus": {
          "$ref": "#/definitions/DriverDutyStatus"
        },
        "hub": {
          "type": [
            "string",
            "null"
          ]
