      "type": "string"
    },
    "CollectRequest": {
      "additionalProperties": false,
      "description": "POST /driver/v1/collection/runs/{runId}/stops/{stopId}/collect — collect this shop's packages.",
      "properties": {
        "changeId": {
          "type": "string"
        },
        "packages": {
          "description": "⚠ ADDED BY 063, OPTIONAL BY DESIGN. Absent means what it has always meant: every package at this stop was collected. Present, it records each package's own outcome IN THE SAME REQUEST.\n\nThat atomicity is the point (FR-026). With collect-all followed by a separate `/issue` call there is a window in which the platform believes a package is in the van and it is not — and if the second call never arrives (the driver walks out of signal, the app is killed), the window never closes and nobody is told. One request cannot half-happen.\n\n⚠ It is OPTIONAL rather than required so the existing client call remains valid and no Kotlin call site changes. A required field here would have meant reworking the ViewModels behind several of 060's screens to say something the old shape already said correctly.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "outcome": {
                "enum": [
                  "picked_up",
                  "not_available"
                ],
                "type": "string"
              },
              "packageId": {
                "type": "string"
              }
            },
            "required": [
              "packageId",
              "outcome"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "changeId"
      ],
      "type": "object"
    },
    "CollectResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "collected",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "CollectionIssueRequest": {
      "additionalProperties": false,
      "description": "POST /driver/v1/collection/runs/{runId}/stops/{stopId}/issue — report a missing/short package.",
