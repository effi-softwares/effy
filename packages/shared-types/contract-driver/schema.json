          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dutyStatus",
        "since",
        "expectedEndAt"
      ],
      "type": "object"
    },
