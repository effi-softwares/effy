    "CollectionStopDTO": {
      "additionalProperties": false,
      "description": "GET /driver/v1/collection/runs/{runId}/stops/{stopId} — a shop stop and its packages.",
      "properties": {
        "address": {
          "description": "⚠ See `CollectionStopSummary.address` — added by 063, retires the `stopAddress` placeholder.",
          "type": [
            "string",
            "null"
          ]
        },
        "packages": {
          "items": {
            "$ref": "#/definitions/CollectionPackage"
          },
          "type": "array"
