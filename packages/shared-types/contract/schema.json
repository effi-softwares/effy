{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ChangePasswordDTO": {
      "additionalProperties": false,
      "description": "Changing an existing password; Cognito verifies `currentPassword`.",
      "properties": {
        "currentPassword": {
          "type": "string"
        },
        "mode": {
          "const": "change",
          "type": "string"
        },
        "newPassword": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "currentPassword",
        "newPassword"
      ],
      "type": "object"
    },
    "ClosureBlockerDTO": {
      "additionalProperties": false,
      "properties": {
        "clearsAt": {
          "description": "Never null.",
          "type": "string"
        },
        "href": {
          "description": "Where the customer goes to act on it (web).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ClosureBlockerKind"
        },
        "reference": {
          "description": "Shopper-facing reference, e.g. `EFY-HVX2AE`.",
          "type": "string"
        },
        "target": {
          "additionalProperties": false,
          "description": "The same destination as a closed vocabulary (mobile has no URL router).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "order",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "reference",
        "href",
        "target",
        "clearsAt"
      ],
      "type": "object"
    },
    "ClosureBlockerKind": {
      "const": "order_in_transit",
      "description": "Why a customer cannot be deleted yet. Every blocker must say when it clears (`clearsAt` is non-nullable): earlier rules left frequent shoppers permanently undeletable.",
      "type": "string"
    },
    "ClosureChallengeResultDTO": {
      "additionalProperties": false,
      "description": "The step-up challenge for closure (the password flow's masked-destination shape).",
      "properties": {
        "maskedDestination": {
          "type": "string"
        }
      },
      "required": [
        "maskedDestination"
      ],
      "type": "object"
    },
    "ClosurePreviewDTO": {
      "additionalProperties": false,
      "description": "Everything the customer sees before any irreversible step. Side-effect free.",
      "properties": {
        "activeRequest": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "eraseAfter": {
                  "type": "string"
                },
                "requestedAt": {
                  "type": "string"
                }
              },
              "required": [
                "requestedAt",
                "eraseAfter"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when a request is already live."
        },
        "blockers": {
          "description": "Empty: closure may proceed.",
          "items": {
            "$ref": "#/definitions/ClosureBlockerDTO"
          },
          "type": "array"
        },
        "eraseAfterIfRequestedNow": {
          "description": "Advisory until a request actually exists.",
          "type": "string"
        },
        "pointsHeld": {
          "$ref": "#/definitions/WireInt",
          "description": "The points lost when closure becomes final, and their value, told before confirming."
        },
        "pointsValueAmount": {
          "type": "string"
        },
        "retained": {
          "items": {
            "$ref": "#/definitions/RetainedCategoryDTO"
          },
          "type": "array"
        }
      },
      "required": [
        "blockers",
        "retained",
        "eraseAfterIfRequestedNow",
        "activeRequest"
      ],
      "type": "object"
    },
    "ClosureRequestDTO": {
      "additionalProperties": false,
      "description": "Confirming closure: the code pays for it; a session alone may not.",
      "properties": {
        "code": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "ClosureRestoreResultDTO": {
      "additionalProperties": false,
      "description": "Cancels a live closure during the grace window. An explicit call, never inferred from a read: the gate would refuse it, and any holder of the token would un-delete the account by opening the app.",
      "properties": {
        "restoredAt": {
          "type": "string"
        }
      },
      "required": [
        "restoredAt"
      ],
      "type": "object"
    },
    "ClosureResultDTO": {
      "additionalProperties": false,
      "properties": {
        "allSessionsRevoked": {
          "const": true,
          "type": "boolean"
        },
        "eraseAfter": {
          "description": "The date the customer is now owed.",
          "type": "string"
        }
      },
      "required": [
        "eraseAfter",
        "allSessionsRevoked"
      ],
      "type": "object"
    },
    "ClosureState": {
      "description": "Where a customer is in closure. `\"closing\"`: the grace window is running and every request is refused except restore.",
      "enum": [
        "open",
        "closing"
      ],
      "type": "string"
    },
    "ConsentChange": {
      "additionalProperties": false,
      "properties": {
        "news": {
          "type": "boolean"
        },
        "offers": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ConsentStateDTO": {
      "additionalProperties": false,
      "properties": {
        "answeredAt": {
          "description": "ISO 8601; null when they have never answered.",
          "type": [
            "string",
            "null"
          ]
        },
        "granted": {
          "type": "boolean"
        }
      },
      "required": [
        "granted",
        "answeredAt"
      ],
      "type": "object"
    },
    "ConsentSurface": {
      "enum": [
        "app",
        "web"
      ],
      "type": "string"
    },
    "ConsentVia": {
      "enum": [
        "settings",
        "prompt",
        "inbox"
      ],
      "type": "string"
    },
    "CredentialRoute": {
      "description": "How a customer proved who they are. Telemetry and UI only, never an authorization input.",
      "enum": [
        "password",
        "otp",
        "google"
      ],
      "type": "string"
    },
    "CustomerDTO": {
      "additionalProperties": false,
      "description": "The platform's own record of a customer, authoritative for access: a `barred` customer is refused whatever their credential. No `role`: the customer pool has no groups (which also keeps the session cookies under the browser's size limit).",
      "properties": {
        "closureState": {
          "$ref": "#/definitions/ClosureState",
          "description": "Has this customer asked to be deleted? Not a value of `status`, which is a platform sanction the customer cannot influence (a customer can be barred and closing). An erased account (113) is never served: its row stays, emptied, only so orders and points keep their owner (`erased`, refused by every customer route)."
        },
        "createdAt": {
          "type": "string"
        },
        "email": {
          "description": "The verified email: the identity key across every credential route.",
          "type": "string"
        },
        "emailDelivery": {
          "$ref": "#/definitions/EmailDeliveryState",
          "description": "How reliably the platform can reach this email. Authenticated surfaces only: on a sign-in screen it would reveal whether an address has an account. `\"reachable\"` when nothing is known. No reason or diagnostic (those stay in back-office)."
        },
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "givenName": {
          "description": "First and last name, captured at registration and mapped onto Cognito's `given_name` / `family_name`. Nullable: a federated provider may assert neither, and no name is invented.",
          "type": [
            "string",
            "null"
          ]
        },
        "hasPassword": {
          "description": "Does this account have a password? The platform holds it because Cognito cannot be asked. The account page branches on this only, never on how the customer signed in.",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "passwordUpdatedAt": {
          "description": "When the password last changed; `null` means never, a complete state for an email-code customer.",
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "description": "A self-asserted contact phone, never verified: never shown with a verified mark and never accepted by any identity or recovery path (so there is no `phoneVerified`). Distinct from `AddressDTO.phone`, the per-address delivery contact; neither overrides the other.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/CustomerStatus"
        }
      },
      "required": [
        "id",
        "email",
        "givenName",
        "familyName",
        "phone",
        "status",
        "closureState",
        "hasPassword",
        "passwordUpdatedAt",
        "emailDelivery",
        "createdAt"
      ],
      "type": "object"
    },
    "CustomerPointsDTO": {
      "additionalProperties": false,
      "description": "GET /customer/v1/points: the balance and a page of history in one answer (every points screen shows both). `?cursor=` pages it.",
      "properties": {
        "centsPerPoint": {
          "$ref": "#/definitions/WireInt"
        },
        "history": {
          "$ref": "#/definitions/PointsHistoryPageDTO"
        },
        "nextExpiry": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "points": {
                  "$ref": "#/definitions/WireInt"
                }
              },
              "required": [
                "points",
                "date"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The soonest lot to expire; null when nothing is due."
        },
        "points": {
          "$ref": "#/definitions/WireInt"
        },
        "valueAmount": {
          "type": "string"
        }
      },
      "required": [
        "centsPerPoint",
        "history",
        "nextExpiry",
        "points",
        "valueAmount"
      ],
      "type": "object"
    },
    "CustomerStatus": {
      "description": "A customer's standing with Effy: platform-owned, never derived from a token claim.",
      "enum": [
        "active",
        "barred"
      ],
      "type": "string"
    },
    "EmailDeliveryState": {
      "description": "The platform's conclusion about reaching an address, from per-message outcomes (a successful `SendEmail` proves nothing):\n- `reachable` the last outcome was a delivery, or nothing is known.\n- `soft_failing` a transient failure; informational, gates nothing.\n- `undeliverable` a permanent failure; a lockout for the passwordless audiences.\n- `complained` marked as spam; surfaced, but never bars sign-in (it usually means someone typed  a stranger's address).",
      "enum": [
        "reachable",
        "soft_failing",
        "undeliverable",
        "complained"
      ],
      "type": "string"
    },
    "InboxArchiveDTO": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "archived"
      ],
      "type": "object"
    },
    "InboxArchiveRequest": {
      "additionalProperties": false,
      "description": "`PATCH …/{id}`.",
      "properties": {
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "archived"
      ],
      "type": "object"
    },
    "InboxCountDTO": {
      "additionalProperties": false,
      "description": "`GET …/unseen-count` and `POST …/seen`.",
      "properties": {
        "unseenCount": {
          "type": "number"
        }
      },
      "required": [
        "unseenCount"
      ],
      "type": "object"
    },
    "InboxCutoffRequest": {
      "additionalProperties": false,
      "description": "`POST …/seen` and `POST …/read-all`: the createdAt of the newest item the person was shown.",
      "properties": {
        "before": {
          "type": "string"
        }
      },
      "required": [
        "before"
      ],
      "type": "object"
    },
    "InboxItemDTO": {
      "additionalProperties": false,
      "description": "One notification in a list.",
      "properties": {
        "body": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "createdAt": {
          "description": "ISO 8601.",
          "type": "string"
        },
        "destination": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "As stored (109's vocabulary); parse it with the same lenient parser as a push.",
          "type": "object"
        },
        "endsLabel": {
          "description": "\"Ends Sun\", only for offers, news, announcements and important items with an end; otherwise null.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "description": "A message's picture (112), at Effy's public picture address; null for everything else.",
          "type": [
            "string",
            "null"
          ]
        },
        "importance": {
          "enum": [
            "normal",
            "important"
          ],
          "type": "string"
        },
        "pinnedUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "readAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "category",
        "importance",
        "title",
        "body",
        "destination",
        "createdAt",
        "readAt",
        "pinnedUntil",
        "endsLabel",
        "imageUrl"
      ],
      "type": "object"
    },
    "InboxPageDTO": {
      "additionalProperties": false,
      "description": "`GET /{audience}/v1/notifications`.",
      "properties": {
        "categories": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "First page only: the categories that have listed items. null on later pages."
        },
        "items": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/definitions/InboxItemDTO"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "null at the end.",
          "type": [
            "string",
            "null"
          ]
        },
        "pinned": {
          "description": "Important unread items still pinned; first page only, otherwise empty. Never repeated in `items`.",
          "items": {
            "$ref": "#/definitions/InboxItemDTO"
          },
          "type": "array"
        },
        "unseenCount": {
          "type": "number"
        }
      },
      "required": [
        "pinned",
        "items",
        "nextCursor",
        "categories",
        "unseenCount"
      ],
      "type": "object"
    },
    "InboxReadAllDTO": {
      "additionalProperties": false,
      "description": "`POST …/read-all`.",
      "properties": {
        "unseenCount": {
          "type": "number"
        },
        "updated": {
          "type": "number"
        }
      },
      "required": [
        "updated",
        "unseenCount"
      ],
      "type": "object"
    },
    "MarketingConsentDTO": {
      "additionalProperties": false,
      "properties": {
        "news": {
          "$ref": "#/definitions/ConsentStateDTO"
        },
        "offers": {
          "$ref": "#/definitions/ConsentStateDTO"
        }
      },
      "required": [
        "offers",
        "news"
      ],
      "type": "object"
    },
    "NotificationPreferencesChange": {
      "additionalProperties": false,
      "description": "`PATCH /customer/v1/notification-preferences`: all or nothing.",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/definitions/PreferenceChoiceChange"
          },
          "type": "array"
        },
        "consent": {
          "$ref": "#/definitions/ConsentChange"
        },
        "emailWordingVersion": {
          "description": "115: the marketing-email wording shown; required when a change turns email ON for offers or news, and must be the current one (else 409 `consent_wording_changed`). Email for a category also needs that category's yes (else 400 `consent_required`).",
          "type": "string"
        },
        "surface": {
          "$ref": "#/definitions/ConsentSurface"
        },
        "via": {
          "$ref": "#/definitions/ConsentVia",
          "description": "Where a consent answer was given; required with `consent`."
        },
        "wordingVersion": {
          "description": "The wording version shown; required with `consent`, and must be the current one (else 409).",
          "type": "string"
        }
      },
      "required": [
        "surface"
      ],
      "type": "object"
    },
    "NotificationPreferencesDTO": {
      "additionalProperties": false,
      "description": "`GET` / `PATCH /customer/v1/notification-preferences`.",
      "properties": {
        "askForOffers": {
          "description": "Show the one-time offers ask: they have never answered and have at least one paid order.",
          "type": "boolean"
        },
        "categories": {
          "items": {
            "$ref": "#/definitions/PreferenceCategoryDTO"
          },
          "type": "array"
        },
        "consent": {
          "$ref": "#/definitions/MarketingConsentDTO"
        },
        "emailWordingVersion": {
          "description": "115: the marketing-EMAIL wording version current now; sent back as `emailWordingVersion` when turning email on.",
          "type": "string"
        },
        "wordingVersion": {
          "description": "The consent wording version the server holds as current.",
          "type": "string"
        }
      },
      "required": [
        "categories",
        "consent",
        "askForOffers",
        "wordingVersion",
        "emailWordingVersion"
      ],
      "type": "object"
    },
    "NotificationReadResponseDTO": {
      "additionalProperties": false,
      "description": "`POST /{audience}/v1/notifications/{id}/read` (109): the caller's own notification, now read. `destination` is the stored one, as a plain object, so an app parses it with the same lenient parser it uses for a push.",
      "properties": {
        "destination": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "notificationId": {
          "type": "string"
        },
        "readAt": {
          "description": "ISO 8601. The first read time; a repeat keeps it.",
          "type": "string"
        }
      },
      "required": [
        "notificationId",
        "readAt",
        "destination"
      ],
      "type": "object"
    },
    "PasswordChallengeResultDTO": {
      "additionalProperties": false,
      "description": "The step-up result: a masked destination only, never the address or the code.",
      "properties": {
        "maskedDestination": {
          "description": "e.g. `j•••@example.com`",
          "type": "string"
        }
      },
      "required": [
        "maskedDestination"
      ],
      "type": "object"
    },
    "PasswordWriteDTO": {
      "anyOf": [
        {
          "$ref": "#/definitions/SetPasswordDTO"
        },
        {
          "$ref": "#/definitions/ChangePasswordDTO"
        }
      ]
    },
    "PasswordWriteResultDTO": {
      "additionalProperties": false,
      "description": "After a password write every session is revoked (Cognito's revocation is all-or-nothing), this one included.",
      "properties": {
        "allSessionsRevoked": {
          "const": true,
          "type": "boolean"
        },
        "customer": {
          "$ref": "#/definitions/CustomerDTO"
        }
      },
      "required": [
        "customer",
        "allSessionsRevoked"
      ],
      "type": "object"
    },
    "PointsBalanceDTO": {
      "additionalProperties": false,
      "description": "GET /customer/v1/points",
      "properties": {
        "centsPerPoint": {
          "$ref": "#/definitions/WireInt"
        },
        "nextExpiry": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "points": {
                  "$ref": "#/definitions/WireInt"
                }
              },
              "required": [
                "points",
                "date"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The soonest lot to expire; null when nothing is due."
        },
        "points": {
          "$ref": "#/definitions/WireInt"
        },
        "valueAmount": {
          "type": "string"
        }
      },
      "required": [
        "points",
        "valueAmount",
        "centsPerPoint",
        "nextExpiry"
      ],
      "type": "object"
    },
    "PointsEntryKind": {
      "description": "Every kind of change to a balance. Credits are positive, debits negative.",
      "enum": [
        "staff_credit",
        "auto_credit",
        "returned",
        "staff_debit",
        "spent",
        "expired",
        "forfeited"
      ],
      "type": "string"
    },
    "PointsHistoryEntryDTO": {
      "additionalProperties": false,
      "description": "One history line as the customer sees it.",
      "properties": {
        "at": {
          "type": "string"
        },
        "expiresOn": {
          "description": "Credits only: the last date these points can be used (yyyy-mm-dd, Melbourne).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/PointsEntryKind"
        },
        "orderNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "points": {
          "$ref": "#/definitions/WireInt",
          "description": "Signed."
        },
        "valueAmount": {
          "type": "string"
        },
        "words": {
          "description": "The sentence to show, decided by the server from the reason.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "points",
        "valueAmount",
        "words",
        "orderNumber",
        "expiresOn",
        "at"
      ],
      "type": "object"
    },
    "PointsHistoryPageDTO": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/definitions/PointsHistoryEntryDTO"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Absent on the last page.",
          "type": "string"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "PreferenceCategoryDTO": {
      "additionalProperties": false,
      "description": "One category as the customer sees it: the effective choice per channel (theirs, else the default).",
      "properties": {
        "category": {
          "type": "string"
        },
        "changeable": {
          "description": "The channels the customer may change; empty when required.",
          "items": {
            "$ref": "#/definitions/PreferenceChannel"
          },
          "type": "array"
        },
        "email": {
          "type": "boolean"
        },
        "marketing": {
          "type": "boolean"
        },
        "push": {
          "description": "For a marketing category, the push choice; it takes effect only while consent is granted.",
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "required",
        "marketing",
        "push",
        "email",
        "changeable"
      ],
      "type": "object"
    },
    "PreferenceChannel": {
      "enum": [
        "push",
        "email"
      ],
      "type": "string"
    },
    "PreferenceChoiceChange": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/definitions/PreferenceChannel"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "channel",
        "enabled"
      ],
      "type": "object"
    },
    "ProblemFieldIssue": {
      "additionalProperties": false,
      "description": "RFC 9457 problem+json: the platform's one machine-readable error shape.",
