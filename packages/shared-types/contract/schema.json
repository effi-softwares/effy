{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ChangePasswordDTO": {
      "additionalProperties": false,
      "description": "Changing an existing password; Cognito verifies `currentPassword`.",
      "properties": {
        "currentPassword": {
          "type": "string"
        },
        "mode": {
          "const": "change",
          "type": "string"
        },
        "newPassword": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "currentPassword",
        "newPassword"
      ],
      "type": "object"
    },
    "ClosureBlockerDTO": {
      "additionalProperties": false,
      "properties": {
        "clearsAt": {
          "description": "Never null.",
          "type": "string"
        },
        "href": {
          "description": "Where the customer goes to act on it (web).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ClosureBlockerKind"
        },
        "reference": {
          "description": "Shopper-facing reference, e.g. `EFY-HVX2AE`.",
          "type": "string"
        },
        "resolvableByShopper": {
          "description": "Whether the customer can act on it, or only wait.",
          "type": "boolean"
        },
        "target": {
          "additionalProperties": false,
          "description": "The same destination as a closed vocabulary (mobile has no URL router).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "order",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "reference",
        "href",
        "target",
        "clearsAt",
        "resolvableByShopper"
      ],
      "type": "object"
    },
    "ClosureBlockerKind": {
      "description": "Why a customer cannot be deleted yet. Every blocker must say when it clears (`clearsAt` is non-nullable): earlier rules left frequent shoppers permanently undeletable.",
      "enum": [
        "order_awaiting_payment",
        "order_in_transit"
      ],
      "type": "string"
    },
    "ClosureChallengeResultDTO": {
      "additionalProperties": false,
      "description": "The step-up challenge for closure (the password flow's masked-destination shape).",
      "properties": {
        "maskedDestination": {
          "type": "string"
        }
      },
      "required": [
        "maskedDestination"
      ],
      "type": "object"
    },
    "ClosurePreviewDTO": {
      "additionalProperties": false,
      "description": "Everything the customer sees before any irreversible step. Side-effect free.",
      "properties": {
        "activeRequest": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "eraseAfter": {
                  "type": "string"
                },
                "requestedAt": {
                  "type": "string"
                }
              },
              "required": [
                "requestedAt",
                "eraseAfter"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when a request is already live."
        },
        "blockers": {
          "description": "Empty: closure may proceed.",
          "items": {
            "$ref": "#/definitions/ClosureBlockerDTO"
          },
          "type": "array"
        },
        "eraseAfterIfRequestedNow": {
          "description": "Advisory until a request actually exists.",
          "type": "string"
        },
        "pointsHeld": {
          "$ref": "#/definitions/WireInt",
          "description": "The points lost when closure becomes final, and their value, told before confirming."
        },
        "pointsValueAmount": {
          "type": "string"
        },
        "retained": {
          "items": {
            "$ref": "#/definitions/RetainedCategoryDTO"
          },
          "type": "array"
        }
      },
      "required": [
        "blockers",
        "retained",
        "eraseAfterIfRequestedNow",
        "activeRequest"
      ],
      "type": "object"
    },
    "ClosureRequestDTO": {
      "additionalProperties": false,
      "description": "Confirming closure: the code pays for it; a session alone may not.",
      "properties": {
        "code": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "ClosureRestoreResultDTO": {
      "additionalProperties": false,
      "description": "Cancels a live closure during the grace window. An explicit call, never inferred from a read: the gate would refuse it, and any holder of the token would un-delete the account by opening the app.",
      "properties": {
        "restoredAt": {
          "type": "string"
        }
      },
      "required": [
        "restoredAt"
      ],
      "type": "object"
    },
    "ClosureResultDTO": {
      "additionalProperties": false,
      "properties": {
        "allSessionsRevoked": {
          "const": true,
          "type": "boolean"
        },
        "eraseAfter": {
          "description": "The date the customer is now owed.",
          "type": "string"
        }
      },
      "required": [
        "eraseAfter",
        "allSessionsRevoked"
      ],
      "type": "object"
    },
    "ClosureState": {
      "description": "Where a customer is in closure. `\"closing\"`: the grace window is running and every request is refused except restore.",
      "enum": [
        "open",
        "closing"
      ],
      "type": "string"
    },
    "CredentialRoute": {
      "description": "How a customer proved who they are. Telemetry and UI only, never an authorization input.",
      "enum": [
        "password",
        "otp",
        "google"
      ],
      "type": "string"
    },
    "CustomerDTO": {
      "additionalProperties": false,
      "description": "The platform's own record of a customer, authoritative for access: a `barred` customer is refused whatever their credential. No `role`: the customer pool has no groups (which also keeps the session cookies under the browser's size limit).",
      "properties": {
        "closureState": {
          "$ref": "#/definitions/ClosureState",
          "description": "Has this customer asked to be deleted? Not a value of `status`, which is a platform sanction the customer cannot influence (a customer can be barred and closing). No `\"closed\"`: erasure removes the row."
        },
        "createdAt": {
          "type": "string"
        },
        "email": {
          "description": "The verified email: the identity key across every credential route.",
          "type": "string"
        },
        "emailDelivery": {
          "$ref": "#/definitions/EmailDeliveryState",
          "description": "How reliably the platform can reach this email. Authenticated surfaces only: on a sign-in screen it would reveal whether an address has an account. `\"reachable\"` when nothing is known. No reason or diagnostic (those stay in back-office)."
        },
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "givenName": {
          "description": "First and last name, captured at registration and mapped onto Cognito's `given_name` / `family_name`. Nullable: a federated provider may assert neither, and no name is invented.",
          "type": [
            "string",
            "null"
          ]
        },
        "hasPassword": {
          "description": "Does this account have a password? The platform holds it because Cognito cannot be asked. The account page branches on this only, never on how the customer signed in.",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "passwordUpdatedAt": {
          "description": "When the password last changed; `null` means never, a complete state for an email-code customer.",
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "description": "A self-asserted contact phone, never verified: never shown with a verified mark and never accepted by any identity or recovery path (so there is no `phoneVerified`). Distinct from `AddressDTO.phone`, the per-address delivery contact; neither overrides the other.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/CustomerStatus"
        }
      },
      "required": [
        "id",
        "email",
        "givenName",
        "familyName",
        "phone",
        "status",
        "closureState",
        "hasPassword",
        "passwordUpdatedAt",
        "emailDelivery",
        "createdAt"
      ],
      "type": "object"
    },
    "CustomerPointsDTO": {
      "additionalProperties": false,
      "description": "GET /customer/v1/points: the balance and a page of history in one answer (every points screen shows both). `?cursor=` pages it.",
      "properties": {
        "centsPerPoint": {
          "$ref": "#/definitions/WireInt"
        },
        "history": {
          "$ref": "#/definitions/PointsHistoryPageDTO"
        },
        "nextExpiry": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "points": {
                  "$ref": "#/definitions/WireInt"
                }
              },
              "required": [
                "points",
                "date"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The soonest lot to expire; null when nothing is due."
        },
        "points": {
          "$ref": "#/definitions/WireInt"
        },
        "valueAmount": {
          "type": "string"
        }
      },
      "required": [
        "centsPerPoint",
        "history",
        "nextExpiry",
        "points",
        "valueAmount"
      ],
      "type": "object"
    },
    "CustomerStatus": {
      "description": "A customer's standing with Effy: platform-owned, never derived from a token claim.",
      "enum": [
        "active",
        "barred"
      ],
      "type": "string"
    },
    "EmailDeliveryState": {
      "description": "The platform's conclusion about reaching an address, from per-message outcomes (a successful `SendEmail` proves nothing):\n- `reachable`      the last outcome was a delivery, or nothing is known.\n- `soft_failing`   a transient failure; informational, gates nothing.\n- `undeliverable`  a permanent failure; a lockout for the passwordless audiences.\n- `complained`     marked as spam; surfaced, but never bars sign-in (it usually means someone typed                    a stranger's address).",
      "enum": [
        "reachable",
        "soft_failing",
        "undeliverable",
        "complained"
      ],
      "type": "string"
    },
    "PasswordChallengeResultDTO": {
      "additionalProperties": false,
      "description": "The step-up result: a masked destination only, never the address or the code.",
      "properties": {
        "maskedDestination": {
          "description": "e.g. `j•••@example.com`",
          "type": "string"
        }
      },
      "required": [
        "maskedDestination"
      ],
      "type": "object"
    },
    "PasswordWriteDTO": {
      "anyOf": [
        {
          "$ref": "#/definitions/SetPasswordDTO"
        },
        {
          "$ref": "#/definitions/ChangePasswordDTO"
        }
      ]
    },
    "PasswordWriteResultDTO": {
      "additionalProperties": false,
      "description": "After a password write every session is revoked (Cognito's revocation is all-or-nothing), this one included.",
      "properties": {
        "allSessionsRevoked": {
          "const": true,
          "type": "boolean"
        },
        "customer": {
          "$ref": "#/definitions/CustomerDTO"
        }
      },
      "required": [
        "customer",
        "allSessionsRevoked"
      ],
      "type": "object"
    },
    "PointsBalanceDTO": {
      "additionalProperties": false,
      "description": "GET /customer/v1/points",
      "properties": {
        "centsPerPoint": {
          "$ref": "#/definitions/WireInt"
        },
        "nextExpiry": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "points": {
                  "$ref": "#/definitions/WireInt"
                }
              },
              "required": [
                "points",
                "date"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The soonest lot to expire; null when nothing is due."
        },
        "points": {
          "$ref": "#/definitions/WireInt"
        },
        "valueAmount": {
          "type": "string"
        }
      },
      "required": [
        "points",
        "valueAmount",
        "centsPerPoint",
        "nextExpiry"
      ],
      "type": "object"
    },
    "PointsEntryKind": {
      "description": "Every kind of change to a balance. Credits are positive, debits negative.",
      "enum": [
        "staff_credit",
        "auto_credit",
        "returned",
        "staff_debit",
        "spent",
        "expired",
        "forfeited"
      ],
      "type": "string"
    },
    "PointsHistoryEntryDTO": {
      "additionalProperties": false,
      "description": "One history line as the CUSTOMER sees it.",
      "properties": {
        "at": {
          "type": "string"
        },
        "expiresOn": {
          "description": "Credits only: the last date these points can be used (yyyy-mm-dd, Melbourne).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/PointsEntryKind"
        },
        "orderNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "points": {
          "$ref": "#/definitions/WireInt",
          "description": "Signed."
        },
        "valueAmount": {
          "type": "string"
        },
        "words": {
          "description": "The sentence to show, decided by the server from the reason.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "points",
        "valueAmount",
        "words",
        "orderNumber",
        "expiresOn",
        "at"
      ],
      "type": "object"
    },
    "PointsHistoryPageDTO": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/definitions/PointsHistoryEntryDTO"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Absent on the last page.",
          "type": "string"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "ProblemFieldIssue": {
      "additionalProperties": false,
      "description": "RFC 9457 problem+json: the platform's one machine-readable error shape.",
      "properties": {
        "field": {
          "description": "The offending field path, or for a whole-request refusal a stable machine-readable code (e.g. `cap_below_floor`, `bands_required`), so the client can say which rule was broken.",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ],
      "type": "object"
    },
    "ProblemJSON": {
      "additionalProperties": {},
      "properties": {
        "code": {
          "description": "A stable refusal code where the route defines one (e.g. `slot_required`), mapped by the client to its own copy; `detail` is prose.",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "errors": {
          "description": "Field issues (the wire key is `errors`).",
          "items": {
            "$ref": "#/definitions/ProblemFieldIssue"
          },
          "type": "array"
        },
        "instance": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status"
      ],
      "type": "object"
    },
    "ResetConfirmDTO": {
      "additionalProperties": false,
      "description": "Completes \"forgot password\" through the backend.",
      "properties": {
        "code": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "newPassword": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "code",
        "newPassword"
      ],
      "type": "object"
    },
    "RetainedCategoryDTO": {
      "additionalProperties": false,
      "description": "A category of data kept after erasure, and why, carried as data so every surface states the same true reason.",
      "properties": {
        "category": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "reason"
      ],
      "type": "object"
    },
    "SetPasswordDTO": {
      "additionalProperties": false,
      "description": "Setting a first password: the code pays for it; a session alone may not.",
      "properties": {
        "code": {
          "description": "The step-up code, emailed to the account's verified address.",
          "type": "string"
        },
        "mode": {
          "const": "set",
          "type": "string"
        },
        "newPassword": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "code",
        "newPassword"
      ],
      "type": "object"
    },
    "UpdateCustomerDTO": {
      "additionalProperties": false,
      "description": "What a customer may change about themselves. No `email` (an identity operation), `status` (platform-owned), `hasPassword` (a consequence of the password routes) or `closureState` (only the closure routes write it, after a fresh code).",
      "properties": {
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "givenName": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "description": "Send `\"\"` to clear, never `null`: the mobile client drops nulls, so `null` reads as \"not sent\".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "givenName",
        "familyName",
        "phone"
      ],
      "type": "object"
    },
    "WireInt": {
      "description": "A whole number on the wire. A plain `number` becomes a Kotlin `Double` and sends `1.0`; this makes the schema say `\"integer\"` (a Kotlin `Long`). Use it for every count, quantity, limit and revision.",
      "type": "integer"
    }
  },
  "description": "Codegen entry only. Every field forces a type into the schema.",
  "properties": {
    "changePassword": {
      "$ref": "#/definitions/ChangePasswordDTO"
    },
    "closureBlocker": {
      "$ref": "#/definitions/ClosureBlockerDTO"
    },
    "closureBlockerKind": {
      "$ref": "#/definitions/ClosureBlockerKind"
    },
    "closureChallengeResult": {
      "$ref": "#/definitions/ClosureChallengeResultDTO"
    },
    "closurePreview": {
      "$ref": "#/definitions/ClosurePreviewDTO"
    },
    "closureRequest": {
      "$ref": "#/definitions/ClosureRequestDTO"
    },
    "closureRestoreResult": {
      "$ref": "#/definitions/ClosureRestoreResultDTO"
    },
    "closureResult": {
      "$ref": "#/definitions/ClosureResultDTO"
    },
    "closureState": {
      "$ref": "#/definitions/ClosureState"
    },
    "credentialRoute": {
      "$ref": "#/definitions/CredentialRoute"
    },
    "customer": {
      "$ref": "#/definitions/CustomerDTO"
    },
    "customerPoints": {
      "$ref": "#/definitions/CustomerPointsDTO"
    },
    "passwordChallengeResult": {
      "$ref": "#/definitions/PasswordChallengeResultDTO"
    },
    "passwordWrite": {
      "$ref": "#/definitions/PasswordWriteDTO"
    },
    "passwordWriteResult": {
      "$ref": "#/definitions/PasswordWriteResultDTO"
    },
    "pointsBalance": {
      "$ref": "#/definitions/PointsBalanceDTO"
    },
    "pointsEntryKind": {
      "$ref": "#/definitions/PointsEntryKind"
    },
    "pointsHistoryEntry": {
      "$ref": "#/definitions/PointsHistoryEntryDTO"
    },
    "pointsHistoryPage": {
      "$ref": "#/definitions/PointsHistoryPageDTO"
    },
    "problem": {
      "$ref": "#/definitions/ProblemJSON"
    },
    "resetConfirm": {
      "$ref": "#/definitions/ResetConfirmDTO"
    },
    "retainedCategory": {
      "$ref": "#/definitions/RetainedCategoryDTO"
    },
    "setPassword": {
      "$ref": "#/definitions/SetPasswordDTO"
    },
    "status": {
      "$ref": "#/definitions/CustomerStatus"
    },
    "updateCustomer": {
      "$ref": "#/definitions/UpdateCustomerDTO"
    }
  },
  "required": [
    "status",
    "closureState",
    "customer",
    "updateCustomer",
    "credentialRoute",
    "setPassword",
    "changePassword",
    "passwordWrite",
    "resetConfirm",
    "passwordChallengeResult",
    "passwordWriteResult",
    "closureBlockerKind",
    "closureBlocker",
    "retainedCategory",
    "closurePreview",
    "closureChallengeResult",
    "closureRequest",
    "closureResult",
    "closureRestoreResult",
    "pointsBalance",
    "pointsEntryKind",
    "pointsHistoryEntry",
    "pointsHistoryPage",
    "customerPoints",
    "problem"
  ],
  "type": "object",
  "title": "CustomerContract"
}
