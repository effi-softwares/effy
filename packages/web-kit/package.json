    "./product-page": "./src/product-page/index.ts",
    "./promo-skin": "./src/promo-skin/index.ts",
    "./scanner": "./src/scanner/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "tsc --noEmit",
